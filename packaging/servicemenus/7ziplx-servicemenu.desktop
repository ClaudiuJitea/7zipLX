[Desktop Entry]
Name=7zipLX
Type=Service
ServiceTypes=KonqPopupMenu/Plugin
X-KDE-ServiceTypes=KonqPopupMenu/Plugin
MimeType=application/x-7z-compressed;application/zip;application/x-tar;application/gzip;application/x-gzip;application/x-bzip2;application/x-xz;application/x-rar;application/x-rar-compressed;application/x-cd-image;application/x-iso9660-image;all/allfiles;inode/directory;
Actions=extractHere;compress;
X-KDE-Priority=TopLevel
X-KDE-Submenu=7zipLX

[Desktop Action extractHere]
Name=Extract Here
Icon=archive-extract
Exec=7ziplx --extract-here %f

[Desktop Action compress]
Name=Compress to 7z
Icon=archive-insert
Exec=7ziplx --compress %f
