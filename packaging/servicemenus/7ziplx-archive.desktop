[Desktop Entry]
Type=Service
MimeType=application/x-7z-compressed;application/zip;application/x-zip-compressed;application/x-rar;application/vnd.rar;application/x-tar;application/x-compressed-tar;application/gzip;application/x-gzip;application/x-bzip2;application/x-bzip2-compressed-tar;application/x-xz;application/x-xz-compressed-tar;application/zstd;application/x-zstd-compressed-tar;application/x-lzma;application/x-cd-image;application/x-iso9660-image;application/vnd.debian.binary-package;application/x-rpm;application/x-java-archive;application/vnd.android.package-archive;application/x-cpio;application/x-cab;application/vnd.ms-cab-compressed;application/x-arj;application/x-lha;application/x-apple-diskimage;application/x-wim;
Actions=open;extract;extractHere;extractToFolder;test;
X-KDE-Priority=TopLevel
X-KDE-Submenu=7-Zip

[Desktop Action open]
Name=Open in 7zipLX
Icon=7ziplx
Exec=7ziplx %f

[Desktop Action extract]
Name=Extract Files…
Icon=archive-extract
Exec=7ziplx --extract %F

[Desktop Action extractHere]
Name=Extract Here
Icon=archive-extract
Exec=7ziplx --extract-here %F

[Desktop Action extractToFolder]
Name=Extract to Folder
Icon=archive-extract
Exec=7ziplx --extract-to-folder %F

[Desktop Action test]
Name=Test Archive
Icon=dialog-ok
Exec=7ziplx --test %F
